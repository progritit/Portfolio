{
  "name": "thinkfully-development-portfolio",
  "version": "1.0.0",
  "description": "Thinkfully Development — Clebson Costa's web development portfolio and professional services website.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "webpack serve --config webpack.dev.js",
    "build": "webpack --config webpack.prod.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "security": "semgrep scan --config p/javascript --metrics=off .",
    "security:strict": "semgrep scan --config p/javascript --metrics=off --error .",
    "security:deps": "npm audit",
    "check": "npm run lint && npm run format:check && npm test -- --runInBand && npm run build",
    "check:all": "npm run check && npm run security:strict && npm run security:deps",
    "test": "jest",
    "test:watch": "jest --watch",
    "deploy": "gh-pages -d dist --cname thinkfullydevelopment.com",
    "predeploy": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/progritit/Portfolio.git"
  },
  "keywords": [
    "portfolio",
    "web-development",
    "frontend-development",
    "vanilla-javascript",
    "webpack",
    "jest",
    "responsive-design",
    "accessibility",
    "thinkfully-development"
  ],
  "author": "Clebson Costa",
  "bugs": {
    "url": "https://github.com/progritit/Portfolio/issues"
  },
  "homepage": "https://thinkfullydevelopment.com/",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "babel-jest": "^30.5.1",
    "css-loader": "^7.1.4",
    "eslint": "^10.9.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.11.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.2",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "3.9.6",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
